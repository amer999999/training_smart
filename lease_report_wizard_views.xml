<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lease_report_wizard_form" model="ir.ui.view">
        <field name="name">lease.report.wizard.form</field>
        <field name="model">lease.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Lease Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="property_type"/>
                        <field name="property_id"/>
                        <field name="tenant_id"/>
                        <field name="payment_status"/>
                    </group>
                </group>

                <group invisible="not excel_file">
                    <field name="excel_file" filename="excel_filename" readonly="1"/>
                    <field name="excel_filename" invisible="1"/>
                </group>

                <footer>
                    <button string="Generate Report"
                            name="action_generate_report"
                            type="object"
                            class="btn-primary"
                            invisible="excel_file != False"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lease_report_wizard" model="ir.actions.act_window">
        <field name="name">Lease Report</field>
        <field name="res_model">lease.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Add to menu, like menu_rent_roll_report -->
    <menuitem id="menu_lease_report"
              name="Lease Report"
              parent="menu_real_estate_reports"
              action="action_lease_report_wizard"
              sequence="20"/>
</odoo>
